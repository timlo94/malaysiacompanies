// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id        Int    @id @default(autoincrement())
  rank      Int
  company   String
  sector    String
  marketCap Float
  revenue   Float
  profit    Float
  employees Int

  @@index([company])
  @@index([sector])
  @@index([marketCap])
  @@index([revenue])
}
